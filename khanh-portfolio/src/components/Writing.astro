---
import articles from '../data/articles.json';
import site from '../data/site.json';
---

<section id="writing" class="section alt">
  <div class="container">
    <div class="head">
      <div class="eyebrow">Writing</div>
      <h2 class="h2">Notes from the blue team side.</h2>
      <p class="lede">Articles I publish on Medium about SIEM, detection and what I learn along the way.</p>
    </div>

    <div class="list">
      {articles.length === 0 && <div class="empty">First article coming soon.</div>}
      {articles.map((a) => (
        <a class="item" href={a.url} target="_blank" rel="noopener noreferrer">
          <div class="main">
            <div class="text">
              <div class="it">{a.title}</div>
              <div class="im">{[a.date, a.readTime].filter(Boolean).join(' / ')}</div>
              <div class="is">{a.summary}</div>
              <div class="tags">{a.tags.map((t) => <span class="tag">{t}</span>)}</div>
            </div>
          </div>
          <span class="go">read on Medium &nearr;</span>
        </a>
      ))}
      {site.links.medium && (
        <a class="item" href={site.links.medium} target="_blank" rel="noopener noreferrer">
          <div class="main"><div class="text"><div class="it">All articles on Medium</div></div></div>
          <span class="go">open profile &nearr;</span>
        </a>
      )}
    </div>
  </div>
</section>
