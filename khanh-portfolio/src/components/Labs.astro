---
import labs from '../data/labs.json';

// Newest lab first in labs.json. The day number counts down automatically.
const total = labs.length;
const items = labs.map((l, i) => ({ ...l, day: String(total - i).padStart(2, '0') }));
const categories = ['All', ...new Set(labs.map((l) => l.category))];
const count = (c: string) => (c === 'All' ? total : labs.filter((l) => l.category === c).length);
---

<section id="labs" class="section">
  <div class="container">
    <div class="head">
      <div class="eyebrow">Lab write-ups</div>
      <h2 class="h2">Hands-on, documented.</h2>
      <p class="lede">
        One lab a day. Each write-up opens in Google Drive with the scenario, my approach, screenshots and what I'd do
        differently. Methodology only: no exam content, flags or answer keys.
      </p>
    </div>

    <div class="chips" role="group" aria-label="Filter labs by domain">
      {categories.map((c, i) => (
        <button class="chip" data-cat={c} aria-pressed={i === 0 ? 'true' : 'false'}>{c} {count(c)}</button>
      ))}
    </div>

    <div class="list">
      {items.map((l) => {
        const meta = [l.platform, l.date].filter(Boolean).join(' / ');
        const inner = (
          <>
            <div class="main">
              <div class="day">{l.day}</div>
              <div class="text">
                <div class="it">{l.title}</div>
                <div class="im">{meta}</div>
                <div class="is">{l.summary}</div>
                <div class="tags">{l.tags.map((t) => <span class="tag">{t}</span>)}</div>
              </div>
            </div>
            <span class={`go ${l.url ? '' : 'off'}`}>{l.url ? 'read on Drive ↗' : 'write-up coming soon'}</span>
          </>
        );
        return l.url ? (
          <a class="item" data-lab data-cat={l.category} href={l.url} target="_blank" rel="noopener noreferrer">{inner}</a>
        ) : (
          <div class="item" data-lab data-cat={l.category}>{inner}</div>
        );
      })}
      <div class="item">
        <div class="main">
          <div class="text">
            <div class="it" style="color: var(--muted)">[Next lab]</div>
            <div class="im">new write-up every day</div>
          </div>
        </div>
        <span class="go off">coming soon</span>
      </div>
    </div>
  </div>
</section>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip[data-cat]');
  const rows = document.querySelectorAll<HTMLElement>('[data-lab]');
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const cat = chip.dataset.cat;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      rows.forEach((r) => {
        r.hidden = cat !== 'All' && r.dataset.cat !== cat;
      });
    });
  });
</script>
